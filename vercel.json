{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cooper-fingers-cope-hawaii.trycloudflare.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://cooper-fingers-cope-hawaii.trycloudflare.com/health"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://cooper-fingers-cope-hawaii.trycloudflare.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
